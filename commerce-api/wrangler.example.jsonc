{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nino-printful-commerce-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-16",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nino-printful-commerce",
    "database_id": "REPLACE_WITH_NEW_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *", "0 10 * * *"] },
  "vars": {
    "STOREFRONT_ORIGIN": "https://ninobattaglia.com",
    "STRIPE_MODE": "test",
    "CHECKOUT_ENABLED": "false",
    "FULFILLMENT_ENABLED": "false",
    "PRINTFUL_CATALOG_MODE": "sync",
    "PRINTFUL_STORE_ID": "",
    "SHIPPING_MODE": "",
    "SHIPPING_COUNTRIES": "",
    "SHIPPING_RATE_CENTS": "",
    "SHIPPING_RATE_NAME": "Shipping",
    "STRIPE_TAX_MODE": "",
    "STRIPE_TAX_REGISTRATION_CONFIRMED": "false",
    "CHECKOUT_SUCCESS_PATH": "/shop.html?checkout=success&session_id={CHECKOUT_SESSION_ID}",
    "CHECKOUT_CANCEL_PATH": "/shop.html?checkout=cancelled"
  }
}
