{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nino-printful-commerce-api",
  "main": "src/main.mjs",
  "compatibility_date": "2026-10-16",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nino-printful-commerce",
      "database_id": "3b48a25e-1854-48ca-b821-ef1552d385cc",
      "migrations_dir": "migrations"
    }
  ],
  // Order emails go out through Menu-made's mailer (menu-checkout worker, NinoMail entrypoint): no email key here.
  "services": [
    { "binding": "MAILER", "service": "menu-checkout", "entrypoint": "NinoMail" },
    { "binding": "WRITER", "service": "menu-checkout", "entrypoint": "NinoWrite" }
  ],
  "kv_namespaces": [
    { "binding": "MOCKUPS", "id": "3bd8ca58b3d340da8a1c025ea6f42d12" }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 10 * * *"
    ]
  },
  "vars": {
    "STOREFRONT_ORIGIN": "https://ninobattaglia.com",
    "COMMERCE_API_ORIGIN": "https://nino-printful-commerce-api.ijpbattaglia.workers.dev",
    "STRIPE_ACCOUNT_ID": "acct_1SPsFVQlpYdvqrua",
    "OWNER_EMAIL": "info@menu-made.com",
    "STRIPE_MODE": "live",
    "CHECKOUT_ENABLED": "true",
    "CHECKOUT_PAUSED": "false",
    "FULFILLMENT_ENABLED": "true",
    "PRINTFUL_CATALOG_MODE": "store",
    "PRINTFUL_STORE_ID": "18919013",
    "PRINTFUL_MAX_ORDER_COST_CENTS": "50000",
    "SHIPPING_MODE": "calculated",
    "SHIPPING_COUNTRIES": "PRINTFUL",
    "SHIPPING_RATE_CENTS": "",
    "SHIPPING_RATE_NAME": "Shipping",
    "STRIPE_TAX_MODE": "automatic",
    "STRIPE_PRODUCT_TAX_CODE": "txcd_30011000",
    "STRIPE_TAX_REGISTRATION_CONFIRMED": "true",
    "CHECKOUT_SUCCESS_PATH": "/shop.html?checkout=success&session_id={CHECKOUT_SESSION_ID}",
    "CHECKOUT_CANCEL_PATH": "/shop.html?checkout=cancelled"
  }
}
